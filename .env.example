# TinyFish — required for live discovery, reading, and absence checks.
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# OpenAI-compatible LLM endpoint. Any provider that supports
# POST {LLM_BASE_URL}/chat/completions works.
# Leave LLM_API_KEY/LLM_MODEL blank to run in deterministic mock mode.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# OpenRouter reasoning models can spend the whole response budget thinking.
# Use none for compact structured JSON; leave blank for providers that do not support it.
LLM_REASONING_EFFORT=none
# Set to 1 to force deterministic mock mode even when a key is present.
LLM_MOCK=0

# Optional: request Agent screenshots for absence evidence.
# Account-gated; leave 0 if the account is not enabled.
TINYFISH_SCREENSHOTS=0

# Optional: override the cache directory (defaults to ./data/cache).
# BIASLENS_CACHE_DIR=./data/cache
